<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks the microphone without this, even when
	     the person allows it in the system prompt. The screen recorder asks
	     for the microphone only when its option is on. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
